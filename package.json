{
  "name": "dev-inspector",
  "version": "1.0.1",
  "description": "In-page devtools-style logger panel for web apps (console + network).",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "demo": "vite demo --open",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\"",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js}": [
      "eslint --fix"
    ],
    "*.{css,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "devtools",
    "logger",
    "console",
    "network",
    "fetch",
    "xhr",
    "debug",
    "panel"
  ],
  "author": "Ali Buğatekin",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.0.0"
  }
}
