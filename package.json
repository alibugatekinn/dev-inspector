{
  "name": "dev-inspector",
  "version": "1.2.0",
  "description": "In-page devtools-style logger panel for web apps (console + network).",
  "repository": {
    "type": "git",
    "url": "https://github.com/alibugatekinn/dev-inspector.git"
  },
  "homepage": "https://dev-inspector.alibugatekin.com/",
  "bugs": {
    "url": "https://github.com/alibugatekinn/dev-inspector/issues"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "demo": "vite demo --open",
    "demo:build": "vite build demo",
    "clean": "rm -rf lib",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\"",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js}": [
      "eslint --fix"
    ],
    "*.{css,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "devtools",
    "logger",
    "console",
    "network",
    "fetch",
    "xhr",
    "debug",
    "panel"
  ],
  "author": "Ali Buğatekin",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.0.0"
  }
}
